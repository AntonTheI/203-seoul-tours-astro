<section class="bg-medium-atmospheric-teal">
  <div class="max-w-7xl mx-auto px-5 md:px-22 lg:px-32 py-section-lg">
    <!-- Top row: issue label + headline  |  anchor stat -->
    <div
      class="reveal flex flex-col gap-8 md:flex-row md:items-end md:justify-between md:gap-10"
    >
      <div class="flex flex-col gap-4">
        <span class="accent-label uppercase flex items-center gap-3">
          Newsletter
          <span
            class="hidden sm:inline-block h-px w-full bg-accent-orange-23/50"
          ></span>
        </span>
        <h2
          class="text-5xl md:text-7xl font-bold tracking-tight leading-[0.98] text-dark-chromatic-teal"
        >
          Seoul tips,<br />in your <span class="text-accent-orange-23"
            >inbox</span
          >.
        </h2>
      </div>

      <!-- Anchor stat: the payoff -->
      <div class="flex flex-col md:items-end md:text-right shrink-0">
        <span
          class="text-5xl font-bold tracking-tight leading-none text-dark-chromatic-teal"
          >3 min</span
        >
        <span class="mt-1.5 text-sm text-medium-chromatic-teal"
          >to read, weeks of wandering</span
        >
      </div>
    </div>

    <!-- Divider -->
    <div class="my-8 h-px w-full bg-dark-chromatic-teal/25"></div>

    <!-- Bottom row: topic chips  |  CTA -->
    <div
      class="reveal flex flex-col gap-6 md:flex-row md:items-center md:justify-between md:gap-10"
    >
      <div class="flex flex-wrap gap-3">
        <span
          class="rounded-full border border-dark-chromatic-teal/25 bg-white/15 px-5 py-2 text-sm font-medium text-dark-chromatic-teal"
          >Hidden gems</span
        >
        <span
          class="rounded-full border border-dark-chromatic-teal/25 bg-white/15 px-5 py-2 text-sm font-medium text-dark-chromatic-teal"
          >Food spots</span
        >
        <span
          class="rounded-full border border-dark-chromatic-teal/25 bg-white/15 px-5 py-2 text-sm font-medium text-dark-chromatic-teal"
          >Neighborhood walks</span
        >
        <span
          class="rounded-full border border-dark-chromatic-teal/25 bg-white/15 px-5 py-2 text-sm font-medium text-dark-chromatic-teal"
          >Where locals go</span
        >
      </div>

      <!-- TODO: add your Substack URL to href -->
      <a
        href="https://jitse.substack.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex w-full md:w-auto items-center justify-center gap-2 whitespace-nowrap rounded-full bg-accent-orange-23 px-8 py-4 font-semibold text-dark-chromatic-teal transition-colors hover:bg-accent-orange-deep"
      >
        Subscribe — it's free
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>
