---

<section class="bg-medium-atmospheric-teal">
  <div class="max-w-7xl mx-auto px-5 md:px-22 lg:px-32 py-section-lg">
    <!-- Top row: issue label + headline  |  anchor stat -->
    <div
      class="reveal flex flex-col gap-8 md:flex-row md:items-end md:justify-between md:gap-10"
    >
      <div class="flex flex-col gap-4">
        <span class="accent-label uppercase flex items-center gap-3">
          Newsletter
          <span
            class="hidden sm:inline-block h-px w-full bg-accent-orange-23/50"
          ></span>
        </span>
        <h2
          class="text-5xl md:text-7xl font-bold tracking-tight leading-[0.98] text-dark-chromatic-teal"
        >
          Seoul
          <span class="text-accent-orange-23">Stories,</span><br />in your <span
            class="">inbox.</span
          >
        </h2>
      </div>

      <!-- Anchor stat: the payoff -->
      <div class="self-end flex">
        <a
          href="https://jitse.substack.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full md:w-auto items-center justify-center gap-2 whitespace-nowrap rounded-full bg-accent-orange-23 px-8 py-4 font-semibold text-dark-chromatic-teal transition-colors hover:bg-accent-orange-deep"
        >
          Subscribe — it's free
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 7h10v10"></path><path d="M7 17 17 7"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Divider -->
    <!-- <div class="my-8 h-px w-full bg-dark-chromatic-teal/25"></div> -->
  </div>
</section>
