---

---

<!-- Slide-over card: negative margin pulls it up over the hero -->
<section class="relative z-10 -mt-15 bg-medium-chromatic-teal py-section-lg">
  <div class="max-w-7xl mx-auto px-5 md:px-22 lg:px-32">
    <!-- grid: one column on mobile, two equal columns from lg up -->
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-col-gap items-center">
      <!-- Image: fills its whole column -->
      <div class="overflow-hidden rounded-xl aspect-4/3 lg:aspect-3/2">
        <img
          src="/assets/images/curiosityBanner.jpg"
          alt="A stone city wall with a quiet footpath running alongside it"
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </div>

      <!-- Text: left-aligned -->
      <div class="space-y-6 text-left">
        <p class="reveal accent-label text-light-atmospheric-teal-70">
          Private walking tours.
        </p>
        <h2
          class="reveal text-section font-semibold text-natural-light leading-tight text-balance"
        >
          Curiosity leads the way.
        </h2>
        <p
          class="reveal text-xl text-light-atmospheric-teal-70 leading-relaxed max-w-md"
        >
          The rhythms of daily life.
        </p>
        <div>
          <a
            href="/booking"
            class="inline-block bg-accent-orange-23 px-10 py-4 rounded-full text-natural-light font-semibold whitespace-nowrap transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-natural-light"
          >
            Book a Walk
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
