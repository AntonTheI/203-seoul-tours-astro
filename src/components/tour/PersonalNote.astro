---
interface Props {
  note: string;
  class?: string;
}

const { note, class: className = "" } = Astro.props;
---

<div class={`bg-medium-chromatic-teal ${className}`}>
  <div class="max-w-7xl mx-auto px-5 md:px-22 lg:px-32 py-section-lg">
    <div class="border-l-2 border-accent-orange-23 px-10 lg:mx-10">
      <h2 class="text-section font-semibold text-accent-orange-23">
        A personal note
      </h2>
      <div class="flex h-9 shrink-0"></div>
      <p class="text-natural-light">{note}</p>
    </div>
  </div>
</div>
