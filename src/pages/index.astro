---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.tsx";
import AboutTours from "../components/sections/AboutTours.tsx";
import Introduction from "../components/sections/Introduction.tsx";
import TourCard from "../components/sections/TourCard.tsx";
import TailoredWalks from "../components/sections/TailoredWalks.tsx";
import TravelAssistant from "../components/sections/TravelAssistant.tsx";
import Testimonials from "../components/sections/Testimonials.tsx";
import SocialMediaGrid from "../components/sections/SocialMediaGrid.tsx";
import Substack from "@/components/sections/Substack.astro";
import { getAllTours } from "@/lib/api";

const tours = await getAllTours();
---

<BaseLayout title="Seoul Walking Tours">
  <Hero />
  <AboutTours />
  <Introduction />
  <TourCard tours={tours} />
  <TailoredWalks />
  <TravelAssistant />
  <Testimonials />
  <SocialMediaGrid />
  <Substack />
</BaseLayout>
