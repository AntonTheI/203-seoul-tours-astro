---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAboutPage } from "@/lib/api";
import { PortableText } from "astro-portabletext";

let page = null;
try {
  page = await getAboutPage();
} catch (e) {
  // Sanity unavailable — renders without content
}
---

<BaseLayout title="About — Seoul Walking Tours">
  <div class="bg-natural-light">
    <!-- Intro: text left / portrait right -->
    <section class="pt-section-lg pb-section-sm">
      <div class="max-w-7xl mx-auto px-5 md:px-22 lg:px-32">
        <div class="flex flex-col lg:flex-row gap-col-gap items-center">
          <div class="w-full lg:flex-2 min-w-0">
            {
              page?.introText && (
                <div class="space-y-6 leading-relaxed text-natural-dark-210 pt-content">
                  <PortableText value={page.introText} />
                </div>
              )
            }
          </div>
          <div class="w-full lg:flex-1">
            {
              page?.heroImage && (
                <img
                  src={page.heroImage.url}
                  alt={page.heroImage.alt ?? "Jitse"}
                  class="w-full object-cover rounded-sm"
                />
              )
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Seoul story: photo left / text right -->
    <section class="pb-section-sm">
      <div class="max-w-7xl mx-auto px-5 md:px-22 lg:px-32">
        <div class="flex flex-col-reverse lg:flex-row gap-col-gap items-center">
          <div class="w-full lg:flex-1">
            {
              page?.seoulImage && (
                <img
                  src={page.seoulImage.url}
                  alt={page.seoulImage.alt ?? "Walking in Seoul"}
                  class="w-full object-cover rounded-sm"
                />
              )
            }
          </div>
          <div class="w-full lg:flex-2 min-w-0">
            {
              page?.seoulText && (
                <div class="space-y-6 leading-relaxed text-natural-dark-210 pt-content">
                  <PortableText value={page.seoulText} />
                </div>
              )
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Main text: 203 brand + philosophy + background / photo right -->
    <section class="pb-section-sm">
      <div class="max-w-7xl mx-auto px-5 md:px-22 lg:px-32">
        <div class="flex flex-col lg:flex-row gap-col-gap">
          <div class="w-full lg:flex-2 min-w-0">
            {
              page?.mainText && (
                <div class="space-y-6 leading-relaxed text-natural-dark-210 pt-content">
                  <PortableText value={page.mainText} />
                </div>
              )
            }
          </div>
          <div class="w-full lg:flex-1 flex">
            {
              page?.mainImage && (
                <img
                  src={page.mainImage.url}
                  alt={page.mainImage.alt ?? ""}
                  class="w-full h-full object-cover rounded-sm"
                />
              )
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Workshop: photo left / text right -->
    <section class="pb-section-sm scroll-mt-24" id="seoulphotoworkshops">
      <div class="max-w-7xl mx-auto px-5 md:px-22 lg:px-32">
        <div class="flex flex-col-reverse lg:flex-row gap-col-gap items-center">
          <div class="w-full lg:flex-1">
            {
              page?.workshopImage && (
                <img
                  src={page.workshopImage.url}
                  alt={page.workshopImage.alt ?? "Seoul Photography Workshops"}
                  class="w-full object-cover rounded-sm"
                />
              )
            }
          </div>
          <div class="w-full lg:flex-2 min-w-0">
            {
              page?.workshopText && (
                <div class="space-y-6 leading-relaxed text-natural-dark-210 pt-content">
                  <PortableText value={page.workshopText} />
                </div>
              )
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="pb-section-sm">
      <div class="max-w-7xl mx-auto px-5 md:px-22 lg:px-32">
        <div class="max-w-3xl">
          {
            page?.closingText && (
              <div class="space-y-4 leading-relaxed text-natural-dark-210 italic pt-content">
                <PortableText value={page.closingText} />
              </div>
            )
          }
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="pb-section-lg">
      <div class="max-w-7xl mx-auto px-5 md:px-22 lg:px-32">
        <div class="flex flex-col lg:flex-row gap-8 items-center">
          <div class="w-full lg:flex-2">
            <h2
              class="text-subsection font-semibold text-dark-chromatic-teal mb-4"
            >
              Get in touch
            </h2>
            <p class="leading-relaxed text-natural-dark-210">
              Questions about the tours, curious about Seoul, or have a lemon
              ice cream recommendation? Send me an email — I read and reply to
              everything personally.
            </p>
          </div>
          <div class="w-full lg:flex-1 flex justify-center">
            <a
              href="mailto:contact@jitsejager.com"
              class="border py-3 px-6 rounded-full border-accent-orange-23 text-medium-chromatic-teal hover:bg-accent-orange-23 hover:text-natural-light transition-colors whitespace-nowrap"
            >
              contact@jitsejager.com
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
