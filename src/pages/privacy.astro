---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Privacy Policy — Seoul Walking Tours">
  <div class="bg-natural-light min-h-screen lg:py-20 py-10">
    <div
      class="max-w-7xl mx-auto px-5 md:px-22 lg:px-32 py-16 flex flex-col gap-10"
    >
      <div>
        <h1 class="text-4xl font-semibold mb-2">Privacy Policy</h1>
        <p class="text-sm text-black/50">Last updated: March 2026</p>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="text-xl font-semibold">Who we are</h2>
        <p>
          Seoul Walking Tours is operated by Jitse Jager. If you have any
          questions about this policy, contact us at <a
            href="mailto:contact@jitsejager.com"
            class="underline">contact@jitsejager.com</a
          >.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="text-xl font-semibold">What information we collect</h2>
        <p>
          When you submit a booking request, we collect the following
          information:
        </p>
        <ul class="list-disc list-inside flex flex-col gap-1 text-black/80">
          <li>Your name</li>
          <li>Your email address</li>
          <li>Your group size</li>
          <li>Your preferred dates</li>
          <li>Any additional comments you provide</li>
        </ul>
        <p>
          We do not collect payment information. We do not use tracking cookies
          or third-party analytics tools.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="text-xl font-semibold">Why we collect it</h2>
        <p>
          Your information is used solely to respond to and process your booking
          request. We do not use it for marketing purposes, and we do not sell
          or share it with any third parties.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="text-xl font-semibold">How long we keep it</h2>
        <p>
          We retain booking information for as long as necessary to fulfill the
          purpose it was collected for, after which it is permanently deleted.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="text-xl font-semibold">Your rights</h2>
        <p>
          You have the right to request access to your personal data, or to ask
          for it to be deleted at any time. Contact us at <a
            href="mailto:contact@jitsejager.com"
            class="underline">contact@jitsejager.com</a
          > and we will respond within 30 days.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="text-xl font-semibold">Changes to this policy</h2>
        <p>
          If we make changes to this policy we will update the date at the top
          of this page.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
