---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { TourBookingForm } from "../../components/forms/TourBookingForm";
import PracticalInfo from "../../components/tour/PracticalInfo";
import PersonalNote from "@/components/tour/PersonalNote.astro";
import { getAllTours, getOtherTours } from "../../lib/api.ts";
import type { Tour } from "@/types/tour";
import { PortableText } from "astro-portabletext";

export async function getStaticPaths() {
  const tours = await getAllTours();

  return tours.map((tour: Tour) => ({
    params: { slug: tour.slug.current },
    props: { tour },
  }));
}

const { tour } = Astro.props;
const { title } = tour;

const stops = tour.stops ?? [];

const otherTours = await getOtherTours(tour.slug.current);
---

<BaseLayout title={`${title} — Seoul Walking Tours`}>
  <div class="bg-natural-light">
    <!-- Hero img -->
    <div class="h-116">
      <img
        class="object-cover w-full h-full object-[50%_70%]"
        src={tour.heroImage.url || "/assets/images/marketWideShot.jpg"}
        alt="Market female vendor"
      />
    </div>

    <div class="max-w-7xl mx-auto -my-18 z-10 relative md:px-22 lg:px-32">
      <PracticalInfo
        className="md:rounded-2xl hidden lg:block bg-white mb-8 px-5 py-6"
        info={tour.practicalInfo}
      />
    </div>

    <div
      class="max-w-7xl mx-auto flex flex-col lg:flex-row md:px-22 lg:px-32 gap-5 py-section-lg pt-[clamp(30px,5vw,64px)]"
    >
      <PracticalInfo
        className="md:rounded-2xl lg:hidden bg-white p-5"
        info={tour.practicalInfo}
      />

      <div
        class="flex flex-col flex-2 gap-8 bg-white md:rounded-3xl px-5 py-10"
      >
        <h1 class="flex text-5xl lg:text-section font-semibold text-black">
          {title}
        </h1>
        {
          tour.introImage && (
            <div>
              <img
                src={tour.introImage.url}
                alt={tour.introImage.alt}
                class="object-cover w-full h-full max-w-165 max-h-110"
              />
            </div>
          )
        }

        <!-- Market tour description -->
        <div class="flex flex-col">
          <h2 class="text-section font-semibold mb-4">{tour.introTitle}</h2>
          <div class="flex h-9 justify-center shrink-0">
            <div class="h-0.5 bg-accent-orange-23 w-[40%]"></div>
          </div>
          <PortableText value={tour.introContent ?? []} />
        </div>

        <div class="flex flex-col gap-4">
          {
            stops.map((stop, index) => (
              <div class="flex gap-4 flex-col">
                <div class="flex gap-2 items-center">
                  <div
                    class={`flex justify-center items-center text-xl font-bold rounded-full w-9 h-9 ${stop.icon === "!" ? "text-accent-orange-23 bg-medium-chromatic-teal" : stop.icon === "?" ? "bg-accent-orange-23 text-natural-light" : "text-natural-light bg-accent-orange-23"}`}
                  >
                    {stop.icon}
                  </div>
                  <div>
                    <h3 class="text-subsection font-semibold">{stop.title}</h3>
                    {stop.subtitle && (
                      <p class="text-xs text-black/60">{stop.subtitle}</p>
                    )}
                  </div>
                </div>

                <div class="flex gap-2">
                  <div class="flex justify-center w-9 shrink-0">
                    {index < stops.length - 1 && (
                      <div class="w-px bg-gray-300 h-full" />
                    )}
                  </div>
                  <div>
                    <p class="mb-4">{stop.content}</p>
                    {stop.image && (
                      <img
                        class="rounded-2xl"
                        src={stop.image.url}
                        alt={stop.image.alt}
                      />
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <PersonalNote note={tour.personalNote} class="md:rounded-2xl lg:hidden" />

      <div class="lg:self-start flex-1 sticky top-17">
        <TourBookingForm
          tourSlug={tour.slug.current}
          className="flex flex-col gap-10 md:rounded-2xl bg-white px-5 py-10"
          client:visible
          otherTours={otherTours}
        />
      </div>
    </div>
    <PersonalNote note={tour.personalNote} class="hidden lg:block" />
  </div>
</BaseLayout>
