---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { TourBookingForm } from "../../components/forms/TourBookingForm";
import PracticalInfo from "../../components/tour/PracticalInfo";
import PersonalNote from "@/components/tour/PersonalNote.astro";

interface Stop {
  icon: string;
  title: string;
  subtitle: string;
  content: string;
  image: string;
}

interface Tour {
  slug: string;
  title: { rendered: string };
  content: { rendered: string };
  acf: {
    duration: string;
    walking_level: string;
    meeting_point: string;
    start_time: string;
    best_timing: string;
    hero_image: string;
    intro_title: string;
    intro_subtitle: string;
    intro_content: string;
    personal_note: string;
    [key: string]: string;
  };
}

export async function getStaticPaths() {
  const response = await fetch(
    "http://localhost/tour-guide-site/?rest_route=/wp/v2/tours",
  );
  const tours: Tour[] = await response.json();

  return tours.map((tour: Tour) => ({
    params: { slug: tour.slug },
    props: { tour },
  }));
}

const { tour } = Astro.props;
const { title, acf } = tour;

const stops: Stop[] = [1, 2, 3, 4, 5, 6, 7, 8]
  .map((n) => ({
    icon: acf[`stop_${n}_icon`],
    title: acf[`stop_${n}_title`],
    subtitle: acf[`stop_${n}_subtitle`],
    content: acf[`stop_${n}_content`],
    image: acf[`stop_${n}_image`],
  }))
  .filter((stop) => stop.title);
---

<BaseLayout title={`${title.rendered} — Seoul Walking Tours`}>
  <div class="bg-natural-light">
    <!-- Hero img -->
    <div class="relative h-116 overflow-hidden">
      <img
        class="object-cover w-full h-full object-[50%_70%]"
        src={acf.hero_image || "/assets/images/marketWideShot.jpg"}
        alt="Market female vendor"
      />
      <h1
        class="absolute inset-0 flex items-center justify-center text-5xl lg:text-7xl text-white"
      >
        {title.rendered}
      </h1>
    </div>

    <div
      class="max-w-7xl mx-auto flex flex-col lg:flex-row md:px-22 lg:px-32 gap-5 my-12"
    >
      <PracticalInfo
        className="md:rounded-2xl lg:hidden bg-white p-5"
        info={acf}
      />

      <div class="flex flex-col flex-2 gap-8 bg-white md:rounded-3xl px-5">
        <div class="pt-5">
          <img
            src="/assets/images/marketLady.jpg"
            alt="market lady"
            class="object-cover w-full h-full max-w-165 max-h-110"
          />
        </div>

        <!-- Market tour description -->
        <div class="flex flex-col">
          <h2 class="text-section font-semibold mb-4">{acf.intro_title}</h2>
          <div class="flex h-9 justify-center shrink-0">
            <div class="h-0.5 bg-accent-orange-23 w-[40%]"></div>
          </div>
          <h3 class="font-extrabold">{acf.intro_subtitle}</h3>
          <p class="whitespace-pre-line">{acf.intro_content}</p>
        </div>

        <div class="flex flex-col gap-4">
          {
            stops.map((stop, index) => (
              <div class="flex gap-4 flex-col">
                <div class="flex gap-2 items-center">
                  <div
                    class={`flex justify-center items-center text-xl font-bold rounded-full w-9 h-9 ${stop.icon === "!" ? "text-accent-orange-23 bg-medium-chromatic-teal" : stop.icon === "?" ? "bg-accent-orange-23 text-natural-light" : "text-natural-light bg-accent-orange-23"}`}
                  >
                    {stop.icon}
                  </div>
                  <div>
                    <h3 class="text-subsection font-semibold">{stop.title}</h3>
                    {stop.subtitle && (
                      <p class="text-xs text-black/60">{stop.subtitle}</p>
                    )}
                  </div>
                </div>

                <div class="flex gap-2">
                  <div class="flex justify-center w-9 shrink-0">
                    {index < stops.length - 1 && (
                      <div class="w-px bg-gray-300 h-full" />
                    )}
                  </div>
                  <div>
                    <p class="mb-4">{stop.content}</p>
                    {stop.image && (
                      <img
                        class="rounded-2xl"
                        src={stop.image}
                        alt={stop.title}
                      />
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <PersonalNote note={acf.personal_note} class="md:rounded-2xl lg:hidden" />

      <div class="lg:self-start flex-1 sticky top-17">
        <PracticalInfo
          className="md:rounded-2xl hidden lg:block bg-white mb-8 px-5 py-10"
          info={acf}
        />
        <TourBookingForm
          className="flex flex-col gap-10 md:rounded-2xl bg-white px-5 py-10"
          client:visible
        />
      </div>
    </div>
    <PersonalNote note={acf.personal_note} class="hidden lg:block" />
  </div>
</BaseLayout>
