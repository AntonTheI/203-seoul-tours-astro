---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { TourBookingForm } from "../../components/forms/TourBookingForm";

interface Stop {
  icon: string;
  title: string;
  subtitle: string;
  content: string;
  image: string;
}

interface Tour {
  slug: string;
  title: { rendered: string };
  content: { rendered: string };
  acf: {
    duration: string;
    walking_level: string;
    meeting_point: string;
    start_time: string;
    best_timing: string;
    hero_image: string;
    intro_title: string;
    intro_subtitle: string;
    intro_content: string;
    personal_note: string;
    [key: string]: string;
  };
}

export async function getStaticPaths() {
  const response = await fetch(
    "http://localhost/tour-guide-site/?rest_route=/wp/v2/tours",
  );
  const tours: Tour[] = await response.json();

  return tours.map((tour: Tour) => ({
    params: { slug: tour.slug },
    props: { tour },
  }));
}

const { tour } = Astro.props;
const { title, acf } = tour;

const practicalInfo = [
  { label: "Duration", value: acf.duration },
  { label: "Walking level", value: acf.walking_level },
  { label: "Meeting point", value: acf.meeting_point },
  { label: "Start time", value: acf.start_time },
  { label: "Best timing", value: acf.best_timing },
];

const stops: Stop[] = [1, 2, 3, 4, 5]
  .map((n) => ({
    icon: acf[`stop_${n}_icon`],
    title: acf[`stop_${n}_title`],
    subtitle: acf[`stop_${n}_subtitle`],
    content: acf[`stop_${n}_content`],
    image: acf[`stop_${n}_image`],
  }))
  .filter((stop) => stop.title);
---

<BaseLayout title={`${title.rendered} — Seoul Walking Tours`}>
  <div class="bg-natural-light">
    <!-- Hero -->
    <div class="relative h-116 overflow-hidden">
      <img
        class="object-cover w-full h-full object-[50%_70%]"
        src={acf.hero_image || "/assets/images/marketWideShot.jpg"}
        alt={title.rendered}
      />
      <h1
        class="absolute inset-0 flex items-center justify-center text-5xl lg:text-7xl text-white"
      >
        {title.rendered}
      </h1>
    </div>

    <div
      class="max-w-7xl mx-auto flex flex-col lg:flex-row md:px-22 lg:px-32 gap-5 my-12"
    >
      <!-- Mobile practical info -->
      <div class="md:rounded-2xl lg:hidden bg-white p-5">
        <h4 class="accent-label mb-4">PRACTICAL INFORMATION</h4>
        <div>
          {
            practicalInfo.map((item, index) => (
              <div class="text-sm">
                <div class="flex justify-between">
                  <span class="text-dark-chromatic-teal/70 pr-2">
                    {item.label}
                  </span>
                  <span>{item.value}</span>
                </div>
                {index < practicalInfo.length - 1 && (
                  <hr class="my-2 border-gray-200" />
                )}
              </div>
            ))
          }
        </div>
      </div>

      <!-- Main content -->
      <div class="flex flex-col flex-2 gap-8 bg-white md:rounded-3xl px-5">
        <!-- Intro -->
        <div class="flex flex-col pt-5">
          <h2 class="text-section font-semibold mb-4">{acf.intro_title}</h2>
          <div class="flex h-9 justify-center shrink-0">
            <div class="h-0.5 bg-accent-orange-23 w-[40%]"></div>
          </div>
          <h3 class="font-extrabold">{acf.intro_subtitle}</h3>
          <p class="whitespace-pre-line">{acf.intro_content}</p>
        </div>

        <!-- Stops -->
        <div class="flex flex-col gap-4">
          {
            stops.map((stop, index) => (
              <div class="flex gap-4 flex-col">
                <div class="flex gap-2 items-center">
                  <div
                    class={`flex justify-center items-center text-xl font-bold rounded-full w-9 h-9 ${stop.icon === "!" ? "text-accent-orange-23 bg-medium-chromatic-teal" : "text-natural-light bg-accent-orange-23"}`}
                  >
                    {stop.icon}
                  </div>
                  <div>
                    <h3 class="text-subsection font-semibold">{stop.title}</h3>
                    {stop.subtitle && (
                      <p class="text-xs text-black/60">{stop.subtitle}</p>
                    )}
                  </div>
                </div>

                <div class="flex gap-2">
                  <div class="flex justify-center w-9 shrink-0">
                    {index < stops.length - 1 && (
                      <div class="w-px bg-gray-300 h-full" />
                    )}
                  </div>
                  <div>
                    <p class="mb-4">{stop.content}</p>
                    {stop.image && (
                      <img
                        class="rounded-2xl"
                        src={stop.image}
                        alt={stop.title}
                      />
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Desktop sidebar -->
      <div class="lg:self-start flex-1 sticky top-17">
        <div class="md:rounded-2xl hidden lg:block bg-white mb-8 px-5 py-10">
          <h4 class="accent-label mb-4">PRACTICAL INFORMATION</h4>
          <div>
            {
              practicalInfo.map((item, index) => (
                <div class="text-sm">
                  <div class="flex justify-between">
                    <span class="text-dark-chromatic-teal/70 pr-2">
                      {item.label}
                    </span>
                    <span>{item.value}</span>
                  </div>
                  {index < practicalInfo.length - 1 && (
                    <hr class="my-2 border-gray-200" />
                  )}
                </div>
              ))
            }
          </div>
        </div>
        <TourBookingForm
          className="flex flex-col gap-10 md:rounded-2xl bg-white px-5 py-10"
          client:visible
        />
      </div>
    </div>

    <!-- Personal note -->
    {
      acf.personal_note && (
        <div class="bg-medium-chromatic-teal">
          <div class="max-w-7xl mx-auto px-5 md:px-22 lg:px-32 py-12 md:py-22 lg:py-32">
            <div class="border-l-2 border-accent-orange-23 px-10 lg:mx-10">
              <h2 class="text-section font-semibold text-accent-orange-23">
                A personal note
              </h2>
              <p class="text-natural-light">{acf.personal_note}</p>
            </div>
          </div>
        </div>
      )
    }
  </div>
</BaseLayout>
